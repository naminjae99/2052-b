int n, m, ret, k, Q, L;



vector<int> road[1005];
int penwick[100005];

void upd(int i, int x) {
	while (i <= n) {
		penwick[i] += x;
		i += i & -i;
	}
}
int sum(int i) {
	int re = 0;
	while (i > 0) {
		re += penwick[i];
		i -= i & -i;
	}
	return re;
}
void init(int N, int M, int mType[], int mTime[]){
	n = N; m = M;
	
	for (int i = 0; i < m; i++)
		road[i].clear();
	memset(penwick, 0, sizeof(penwick));

	for (int i = 1; i < n; i++) {
		road[mType[i - 1]].push_back(i);
		upd(i, mTime[i - 1]);
	}
}

void destroy()
{

}

void update(int mID, int mNewTime) {
	mID++;  // 1-indexed
	int cur = sum(mID) - sum(mID - 1);  // 현재 값
	upd(mID, mNewTime - cur);          // 차이만 반영
}
int updateByType(int mTypeID, int mRatio256) {
	int ret = 0;
	for (auto c : road[mTypeID]) {
		int ori = sum(c) - sum(c - 1);
		int nxt = ori * mRatio256 / 256;
		upd(c, nxt - ori);   // 
		ret += nxt;
	}
	return ret;
}
int calculate(int mA, int mB){
	if (mA > mB)
		swap(mA, mB);

	return sum(mB) - sum(mA);
}







