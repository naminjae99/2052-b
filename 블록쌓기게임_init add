using ll = long long;
int n, m, k, Q;

struct Result {
	int top;
	int count;
};
struct f {
	int mn, mx;
	ll sum;
};

f tree[2100000];
ll lazy[2100000];
bool on[2100000];

void down(int node, int s, int e) {
	if (on[node]) {
		tree[node] = { 0,0,0 };
		if (s != e) {
			on[node << 1] = on[(node << 1) | 1]= 1;
			lazy[node << 1] = lazy[(node << 1) | 1] = 0;
		}
		on[node] = 0;
	}
	if (lazy[node]) {
		tree[node].sum += (lazy[node]* (ll)(e-s+1));
		tree[node].mx += lazy[node];
		tree[node].mn += lazy[node];
		if (s != e) {
			lazy[node << 1] += lazy[node];
			lazy[(node << 1)+1] += lazy[node];
		}
		lazy[node] = 0;
	}
}
void upd(int node, int s, int e, int l, int r, ll x) {
	down(node, s, e);
	if (e < l || r < s)
		return;
	if (l <= s && e <= r) {
		lazy[node] += x;
		down(node, s, e);
		return;
	}
	int mid = (s + e) >> 1;
	upd(node << 1, s, mid, l, r, x);
	upd((node << 1) | 1, mid + 1, e, l, r, x);
	tree[node] = { min(tree[node << 1].mn,tree[(node << 1) | 1].mn), max(tree[node << 1].mx,tree[(node << 1) | 1].mx),
	tree[node << 1].sum+tree[(node << 1) | 1].sum};
}

void init(int C){
	n = C;
	on[1] = 1;
	lazy[1] = 0;
	down(1, 0, n - 1);

}

Result dropBlocks(int mCol, int mHeight, int mLength){
	upd(1, 0, n-1, mCol, mCol + mLength - 1, (ll)mHeight);

	down(1, 0, n-1);
	f tp = tree[1];
	Result r;
	r.top = tp.mx - tp.mn;
	r.count= (tp.sum - tp.mn*n) % 1000000;
	return r;

}
