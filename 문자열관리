#include <stdio.h>
#include <iostream>
#include <unordered_set>
#include <string>
#include<algorithm>
#include<deque>
#include <cstring>
#include<unordered_map>
using namespace std;
#define CMD_INIT    1
#define CMD_APPEND  2
#define CMD_CUT     3
#define CMD_REVERSE 4
#define CMD_COUNT   5

bool rev;
unordered_map<string, int>mp[2];
deque<char> dq;
int len;

void init(char mStr[]){
	mp[0].clear();
	mp[1].clear();
	dq.clear();
	rev = 0;

	len= strlen(mStr);

	for (int i = 0; i < len; i++) {
		dq.push_back(mStr[i]);
		string tmp = "";
		for (int j = i; j < min(len,i + 4); j++) {
			tmp += mStr[j];
			mp[0][tmp]++;
		}
		tmp = "";
		for (int j = i; j >= max(0, i - 3); j--) {
			tmp += mStr[j];
			mp[1][tmp]++;
		}
	}


}

void appendWord(char mWord[]){
	if (!rev) {
		int s = strlen(mWord);
		for (int i = 0; i < s; i++) {
			dq.push_back(mWord[i]);
			len++;

			string tmp = "";
			for (int j = 0; j < 4; j++) {
				if (len - 1 - j < 0)
					break;
				tmp = dq[len - 1-j]+tmp;
				mp[rev][tmp]++;
			}
		}
	}
	else {
		int s = strlen(mWord);
		for (int i = 0; i < s; i++) {
			dq.push_front(mWord[i]);
			len++;

			string tmp = "";
			for (int j = 0; j < 4; j++) {
				if (j >= len)
					tmp = dq[j] + tmp;
				mp[rev][tmp]++;
			}
		}
	}
	
}

void cut(int k){
	if (!rev) {

		for (int i = 0; i < k; i++) {
			string tmp = "";
			for (int j = 0; j < 4; j++) {
				if (len - 1 - j < 0)
					break;
				tmp = dq[len - 1 - j]+tmp;
				mp[rev][tmp]--;
			}

			dq.pop_back();
			len--;

		}
	}
	else {

		for (int i = 0; i < k; i++) {
			

			string tmp = "";
			for (int j = 0; j < 4; j++) {
				if (j >= len)
					tmp = dq[j] + tmp;
				mp[rev][tmp]--;
			}

			dq.pop_front();
			len--;
		}
	}
	

}


void reverse(){
	rev != rev;
}

int countOccurrence(char mWord[]) {
	return mp[rev][mWord];
}
